# Azure deployment settings for the scripts in infra/ (no secrets here).
#
#   cp infra/config.env.example infra/config.env   # infra/config.env is gitignored
#
# Then fill in SUBSCRIPTION and SUFFIX. Storage account, Key Vault and function
# app names are global across Azure, so SUFFIX must make them unique: 4-8
# lowercase letters/digits, e.g. the output of `openssl rand -hex 3`.
#
# Any of these can also be set in the environment, which wins over this file.
# GitHub Actions uses AZURE_SUBSCRIPTION_ID / AZURE_RESOURCE_GROUP /
# AZURE_FUNCTION_APP repo secrets instead (see infra/setup-github.sh).

SUBSCRIPTION=00000000-0000-0000-0000-000000000000   # az account show --query id -o tsv
LOCATION=swedencentral                              # any region with Flex Consumption
RESOURCE_GROUP=rg-netatmo-mcp
SUFFIX=changeme

STORAGE_ACCOUNT=stnetatmo${SUFFIX}    # 3-24 chars, lowercase letters/digits only
FUNCTION_APP=netatmo-mcp-${SUFFIX}    # becomes https://<name>.azurewebsites.net (or a regional variant)
KEY_VAULT=kv-netatmo-${SUFFIX}        # 3-24 chars

# Cost guards: maximum function instances, and a monthly budget alert on the
# resource group (in your billing currency; emails the subscription Owners).
MAX_INSTANCES=5
BUDGET_AMOUNT=50

# Key Vault secret names (rarely need changing).
TOKEN_KEY_SECRET=token-key
NETATMO_SECRET_SECRET=netatmo-client-secret
